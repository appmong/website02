---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import FortuneNote from "../components/FortuneNote.astro";
import SubscribeBox from "../components/SubscribeBox.astro";
import { SITE, CATEGORIES } from "../site.config";
import { categoryUrl } from "../lib/utils";

const posts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const latest = posts.slice(0, 9);
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <h1>{SITE.tagline}</h1>
      <p class="sub">{SITE.description}</p>
    </div>
  </section>

  <div class="container">
    <FortuneNote />
  </div>

  <div class="container-wide">
    <section class="cats">
      <h2 class="sec-title">카테고리</h2>
      <div class="cat-grid">
        {CATEGORIES.map((c) => (
          <a href={categoryUrl(c.slug)} class="cat-tile card">
            <span class="emoji" aria-hidden="true">{c.emoji}</span>
            <span class="name">{c.name}</span>
            <span class="d">{c.description}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="latest">
      <h2 class="sec-title">최근 글</h2>
      {latest.length === 0 ? (
        <p class="empty">첫 글을 준비하고 있어요.</p>
      ) : (
        <div class="grid">
          {latest.map((p) => (
            <PostCard
              id={p.id}
              category={p.data.category}
              title={p.data.title}
              description={p.data.description}
              publishDate={p.data.publishDate}
              status={p.data.status}
              thumb={p.data.thumb}
            />
          ))}
        </div>
      )}
    </section>

    <SubscribeBox />
  </div>
</BaseLayout>

<style>
  .hero { padding: 48px 0 12px; text-align: center; }
  .hero h1 { font-size: 34px; letter-spacing: -0.03em; margin: 0 0 12px; line-height: 1.3; }
  .hero .sub { color: var(--text-soft); font-size: 17px; max-width: 560px; margin: 0 auto; }
  .sec-title { font-size: 20px; margin: 40px 0 16px; letter-spacing: -0.02em; }
  .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
  .cat-tile { padding: 16px 18px; display: grid; gap: 4px; color: var(--text); }
  .cat-tile:hover { border-color: var(--accent); text-decoration: none; }
  .cat-tile .emoji { font-size: 24px; }
  .cat-tile .name { font-weight: 800; font-size: 16px; }
  .cat-tile .d { font-size: 13px; color: var(--text-mute); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px; }
  .empty { color: var(--text-mute); padding: 30px 0; }
  @media (max-width: 480px) { .hero h1 { font-size: 27px; } }
</style>
